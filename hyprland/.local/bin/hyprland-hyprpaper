#!/usr/bin/env sh
# hyprland-hyprpaper — start hyprpaper with a home-relative fallback path.
# hyprpaper does not expand $HOME or ~ in config files, so we write the
# absolute path at runtime to stay portable across usernames.
set -eu

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
CONF="$CONF_DIR/hyprpaper-generated.conf"

mkdir -p "$CONF_DIR"

# Resolve the default wallpaper: prefer the user's committed selection,
# then the sway wallpapers dir, then the dotfiles-shipped fallback.
CURRENT="$HOME/.local/state/hypr/wallpaper-current"
if [ -s "$CURRENT" ]; then
    DEFAULT="$(cat "$CURRENT")"
    [ -f "$DEFAULT" ] || DEFAULT="$HOME/.local/state/sway/wallpapers/default.png"
else
    DEFAULT="$HOME/.local/state/sway/wallpapers/default.png"
fi
if [ ! -f "$DEFAULT" ]; then
    DEFAULT="$HOME/.dotfiles/assets/wallpapers/default.png"
fi

# hyprpaper 0.8+ matches each wallpaper block against a concrete output
# name; an empty `monitor =` matches nothing and paints no output at all.
# Emit one block per connected output so the wallpaper lands on every
# screen. Fall back to the legacy empty name if the output list can't be
# read (early boot, hyprctl unavailable) — hyprpaper then applies it to
# all outputs itself.
MONITORS=$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)

{
    echo "# Auto-generated by hyprland-hyprpaper — do not edit."
    echo "# hyprpaper 0.8+: wallpaper rules are wallpaper { } blocks (preload/wallpaper= removed)."
    if [ -n "$MONITORS" ]; then
        printf '%s\n' "$MONITORS" | while IFS= read -r m; do
            [ -n "$m" ] || continue
            printf 'wallpaper {\n    monitor = %s\n    path = %s\n}\n' "$m" "$DEFAULT"
        done
    else
        printf 'wallpaper {\n    monitor =\n    path = %s\n}\n' "$DEFAULT"
    fi
    echo "ipc = on"
    echo "splash = false"
} > "$CONF"

exec hyprpaper -c "$CONF"
