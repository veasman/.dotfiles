#!/usr/bin/env sh
# hyprland-ws — per-output workspace switcher.
#
# Reads the base offset (0, 10, 20, 30) from the state file written
# by hyprland-output-profile, so workspace bindings and dispatch
# always agree.  Falls back to computing from X positions if the
# state file is missing (e.g. profile hasn't run yet).
#
# Usage:
#   hyprland-ws switch <1..9>   focus workspace N on focused output
#   hyprland-ws move   <1..9>   send focused window to N on focused output
#   hyprland-ws center           print name of the center (1440p) monitor

set -eu

usage='usage: hyprland-ws (switch|move) <N> | center'
cmd="${1:?$usage}"

if [ "$cmd" = "center" ]; then
    sorted=$(hyprctl monitors -j | jq -r 'sort_by(.x) | .[] | .name')
    center=$(hyprctl monitors -j | jq -r '.[] | select(.width == 2560) | .name' 2>/dev/null | head -1)
    if [ -n "$center" ]; then
        printf '%s' "$center"
    else
        printf '%s' "$sorted" | sed -n '1p'
    fi
    exit 0
fi

n="${2:?usage}"

monitor=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')

# Read base from the state file written by hyprland-output-profile.
# This ensures hyprland-ws and the profile always agree on which
# workspace range belongs to which monitor, even after position
# changes (DPMS wake, hot-plug, reconnect).
WORKSPACE_BASES="$HOME/.local/state/hypr/workspace-bases"
base=""
if [ -f "$WORKSPACE_BASES" ]; then
    base=$(awk -v m="$monitor" '$1 == m { print $2; exit }' "$WORKSPACE_BASES")
fi

# Fallback: compute from X positions (matches profile's sorted order).
if [ -z "$base" ]; then
    sorted=$(hyprctl monitors -j | jq -r 'sort_by(.x) | .[] | .name')
    total_monitors=$(hyprctl monitors -j | jq length)
    if [ "$monitor" = "eDP-1" ] || [ "$total_monitors" -le 1 ]; then
        base=0
    else
        index=$(printf '%s\n' "$sorted" | grep -v '^eDP-1$' | grep -nFx "$monitor" | cut -d: -f1)
        base=$((index * 10))
    fi
fi

ws=$((base + n))

case "$cmd" in
    switch) hyprctl dispatch workspace "$ws" >/dev/null ;;
    move)   hyprctl dispatch movetoworkspace "$ws" >/dev/null ;;
    *)
        echo "usage: hyprland-ws {switch|move} <N>" >&2
        exit 1
        ;;
esac
