#!/usr/bin/env sh
# hyprland-terminal — detect available terminal emulator
# Prefers footclient/foot.
set -eu

if command -v footclient >/dev/null 2>&1; then
    exec footclient "$@"
fi

if command -v foot >/dev/null 2>&1; then
    exec foot "$@"
fi

echo "hyprland-terminal: no terminal emulator found (tried footclient, foot)" >&2
exit 1
