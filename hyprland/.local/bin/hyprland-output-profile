#!/usr/bin/env sh
# hyprland-output-profile — dynamic docked/undocked monitor layout.
#
# Dispatches to hostname-specific profiles:
#   universe  — 3-monitor laptop dock (portrait sides + 1440p center + eDP-1)
#   computer  — simple desktop with optional 1440p@120 external
#
# Each sub-profile detects docked (1440p present) vs undocked and
# applies the right layout.
#
# Usage:
#   hyprland-output-profile           # apply layout (daemon mode)
#   hyprland-output-profile --swap    # swap cached left↔right sides
#   hyprland-output-profile --redetect  # clear cache and re-detect

set -eu

HOSTNAME=$(uname -n)

# --- state file (persists connector→side mapping across renames) -----
STATE_DIR="$HOME/.local/state/hypr"
STATE="$STATE_DIR/output-layout"
MONITOR_CACHE="$STATE_DIR/output-monitors-cache"
WORKSPACE_BASES="$STATE_DIR/workspace-bases"
mkdir -p "$STATE_DIR" 2>/dev/null || true

read_state()  { [ -f "$STATE" ] && . "$STATE" || true; }
write_state() {
    printf 'left=%s\nleft_t=%s\ncenter=%s\nright=%s\nright_t=%s\n' \
        "$left" "${left_t:-3}" "$center" "$right" "${right_t:-1}" > "$STATE"
}

# Check whether the connected monitor set has changed since the last apply.
# Returns 0 (true) if the set is identical (no re-bind needed), 1 if changed.
# Includes X positions so position shifts (different port, re-plug order)
# also trigger a re-bind — keeps workspace bases in sync.
monitors_unchanged() {
    current=$(hyprctl monitors -j 2>/dev/null | jq -r 'sort_by(.name) | .[] | "\(.name) \(.x)"' | tr '\n' ' ')
    [ -f "$MONITOR_CACHE" ] && [ "$(cat "$MONITOR_CACHE")" = "$current" ]
}

save_monitor_cache() {
    hyprctl monitors -j 2>/dev/null | jq -r 'sort_by(.name) | .[] | "\(.name) \(.x)"' | tr '\n' ' ' > "$MONITOR_CACHE"
}

# --- logging ---------------------------------------------------------
LOGFILE="$HOME/.cache/hypr/output-profile.log"
mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null || true
log() {
    printf '%s %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo '?')" "$*" \
        >>"$LOGFILE" 2>/dev/null || true
}

# Write monitor→base mapping so hyprland-ws uses the same offsets.
# One line per monitor: "monitor_name base_offset"
write_workspace_bases() {
    printf '%s\n' "$@" > "$WORKSPACE_BASES"
}

# --- window migration ---------------------------------------------------
# Move all windows on a given monitor to a target workspace number.
migrate_from_monitor() {
    src="$1"
    target_ws="$2"
    hyprctl clients -j 2>/dev/null | jq -r --arg m "$src" '
        .[] | select(.monitor == $m) | .address
    ' | while IFS= read -r addr; do
        [ -n "$addr" ] && hyprctl dispatch "hl.dsp.window.move({ window = \"address:$addr\", workspace = $target_ws })" >/dev/null 2>&1 || true
    done
    log "migrated $src => workspace $target_ws"
}

# Move all non-laptop windows to a target workspace.
migrate_external_to() {
    target_ws="$1"
    all=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | .name')
    for mon in $all; do
        [ "$mon" = "$laptop" ] && continue
        migrate_from_monitor "$mon" "$target_ws"
    done
}

# --- core -------------------------------------------------------------
apply_profile_universe() {
    all=$(hyprctl monitors -j 2>/dev/null | jq -c '.[]' || true)
    names_connected=$(printf '%s\n' "$all" | jq -r '.name' | tr '\n' ' ')
    log "universe: connected = $names_connected"

    # Skip re-binding if the monitor set hasn't changed — avoids
    # workspace drift from spurious DPMS / connector-flap events.
    if monitors_unchanged; then
        log "universe: monitor set unchanged, skipping re-bind"
        return 0
    fi
    save_monitor_cache

    laptop="eDP-1"
    center=$(printf '%s\n' "$all" | jq -r 'select(.availableModes | any(startswith("2560x1440"))) | .name' | head -1)

    if [ -n "$center" ]; then
        read_state
        names_list=$(printf '%s\n' "$all" | jq -r '.name')
        stale=false
        for v in "${left:-}" "${center:-}" "${right:-}"; do
            [ -n "$v" ] || { stale=true; break; }
            printf '%s\n' "$names_list" | grep -Fxq "$v" || { stale=true; break; }
        done
        center_name=$(printf '%s\n' "$all" | jq -r 'select(.availableModes | any(startswith("2560x1440"))) | .name' | head -1)
        if $stale; then
            log "universe: state stale — re-detecting"
            sides=$(printf '%s\n' "$all" \
                | jq -r 'select(.name | startswith("eDP") | not) | select(((.availableModes | any(startswith("2560x1440"))) | not) and (.availableModes | any(startswith("1920x1080")))) | "\(.x) \(.name)"')
            side_count=$(printf '%s\n' "$sides" | grep -c . || true)
            if [ "$side_count" -ge 2 ]; then
                left=$(printf '%s\n' "$sides" | sort -n -k1 | awk '{print $2}' | sed -n '1p')
                right=$(printf '%s\n' "$sides" | sort -n -k1 | awk '{print $2}' | sed -n '2p')
                log "universe: detection: center=$center left=$left right=$right"
            fi
            transform_for() {
                case "$1" in
                    DVI-I-2) echo 1 ;;
                    DP-2)    echo 3 ;;
                    *)       echo "${2:-1}" ;;
                esac
            }
            if [ -n "${left:-}" ];  then left_t=$(transform_for "$left" 3);  fi
            if [ -n "${right:-}" ]; then right_t=$(transform_for "$right" 1); fi
            [ -z "${left:-}" ] && left="$center"
            [ -z "${right:-}" ] && right="$center"
            center="$center_name"
            write_state
        fi

        log "universe: docked  left=$left  center=$center  right=$right"

        migrate_from_monitor "$laptop" 1

        [ -n "$left"  ] && hyprctl eval "hl.monitor({ output = \"$left\", mode = \"1920x1080\", position = \"0x0\", scale = 1, transform = ${left_t:-3} })"    >/dev/null 2>&1 || true
                               hyprctl eval "hl.monitor({ output = \"$center\", mode = \"2560x1440@120\", position = \"1080x0\", scale = 1 })"    >/dev/null 2>&1 || true
        [ -n "$right" ] && hyprctl eval "hl.monitor({ output = \"$right\", mode = \"1920x1080\", position = \"3640x0\", scale = 1, transform = ${right_t:-1} })" >/dev/null 2>&1 || true
                               hyprctl eval "hl.monitor({ output = \"$laptop\", mode = \"preferred\", position = \"auto\", scale = 1 })"          >/dev/null 2>&1 || true

        [ -n "$left"  ] && hyprctl eval "hl.workspace_rule({ workspace = \"r[11-19]\", monitor = \"$left\", default = true })"   >/dev/null 2>&1 || true
                               hyprctl eval "hl.workspace_rule({ workspace = \"r[21-29]\", monitor = \"$center\", default = true })" >/dev/null 2>&1 || true
        [ -n "$right" ] && hyprctl eval "hl.workspace_rule({ workspace = \"r[31-39]\", monitor = \"$right\", default = true })"  >/dev/null 2>&1 || true

        # Write base offsets so hyprland-ws stays in sync.
        write_workspace_bases "$laptop 0" "$left 10" "$center 20" "$right 30"

        hyprctl dispatch "hl.dsp.focus({ monitor = \"$center\" })"                           >/dev/null 2>&1 || true
    else
        log "universe: undocked -> enabling $laptop"
        migrate_external_to 1
        hyprctl eval "hl.monitor({ output = \"$laptop\", mode = \"preferred\", position = \"auto\", scale = 1 })"                >/dev/null 2>&1 || true
        sleep 0.3
        migrate_from_monitor "$laptop" 1
        write_workspace_bases "$laptop 0"
        hyprctl dispatch "hl.dsp.focus({ monitor = \"$laptop\" })"                           >/dev/null 2>&1 || true
    fi
}

apply_profile_computer() {
    all=$(hyprctl monitors -j 2>/dev/null | jq -c '.[]' || true)
    names_connected=$(printf '%s\n' "$all" | jq -r '.name' | sort | tr '\n' ' ')
    log "computer: connected = $names_connected"

    # Skip re-binding if the monitor set hasn't changed — avoids
    # workspace drift where re-binding recreates workspace instances
    # and orphans windows on the old IDs (e.g. after DPMS wake).
    if monitors_unchanged; then
        log "computer: monitor set unchanged, skipping re-bind"
        return 0
    fi
    save_monitor_cache

    # Monitor modes/positions for this host are declared statically in
    # hyprland.lua (DP-1 @ 1080p120, HDMI-A-1 @ 1080p60). Re-applying
    # them here with hl.monitor() recreates the outputs and can flip the
    # virtual layout, so leave them to the config.

    # Write workspace base offsets so hyprland-ws dispatches to the
    # right 1-9 range on each monitor (base = index * 10, focused first).
    focused=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name')
    sorted=$(hyprctl monitors -j 2>/dev/null | jq -r --arg f "${focused:-}" '
        sort_by(
            if .name == $f then 0 else 1 end,
            .x
        ) | .[] | .name
    ')
    bases_file=$(mktemp)
    index=0
    for mon in $sorted; do
        base=$((index * 10))
        printf '%s %s\n' "$mon" "$base" >> "$bases_file"
        index=$((index + 1))
    done
    # Write base offsets so hyprland-ws stays in sync.
    mv "$bases_file" "$WORKSPACE_BASES"

    hyprctl dispatch "hl.dsp.focus({ monitor = \"$(echo "$sorted" | head -1)\" })" >/dev/null 2>&1 || true
}

# --- hostname dispatch -------------------------------------------------
apply_profile() {
    case "$HOSTNAME" in
        universe) apply_profile_universe ;;
        computer) apply_profile_computer ;;
        *)
            log "skip: unknown host $HOSTNAME"
            ;;
    esac
}

# --- side-swap helper (universe only) ----------------------------------
swap_sides() {
    [ "$HOSTNAME" = universe ] || { echo "swap is only valid on universe" >&2; exit 1; }
    read_state
    if [ -z "${left:-}" ] || [ -z "${right:-}" ]; then
        echo "no cached layout to swap — run the daemon first" >&2
        exit 1
    fi
    tmp="$left"; left="$right"; right="$tmp"
    tmp_t="${left_t:-3}"; left_t="${right_t:-1}"; right_t="$tmp_t"
    write_state
    echo "swapped: left=$left right=$right"
    apply_profile
}

# --- CLI --------------------------------------------------------------
case "${1:-}" in
    --swap|--swap-sides)
        swap_sides
        exit 0
        ;;
    --redetect)
        rm -f "$STATE" "$MONITOR_CACHE"
        apply_profile
        exit 0
        ;;
    --once)
        rm -f "$MONITOR_CACHE"
        apply_profile
        exit 0
        ;;
esac

# --- startup ----------------------------------------------------------
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
# Clear monitor cache on startup so workspace bindings are always
# established fresh — the cache only guards against spurious re-binds
# within a single session (e.g. DPMS wake).
rm -f "$MONITOR_CACHE"
log "start"
apply_profile

# --- hotswap listener (universe only) ---------------------------------
# The laptop dock needs to re-bind on connect/disconnect events.
# The desktop (computer) doesn't need this — re-binding on DPMS wake
# or connector flap causes workspace drift.
if [ "$HOSTNAME" = "universe" ]; then
    SOCK="$RUNTIME/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"
    if [ -S "$SOCK" ] && command -v socat >/dev/null 2>&1; then
        pending_pid=""
        socat -U - "UNIX-CONNECT:$SOCK" 2>/dev/null | while IFS= read -r line; do
            case "$line" in
                monitoradded*|monitorremoved*|monitoraddedv2*|monitorremovedv2*)
                    log "event: ${line%%>>*}"
                    # Debounce: collapse rapid connector-flap storms.
                    if [ -n "$pending_pid" ]; then
                        kill "$pending_pid" 2>/dev/null || true
                        wait "$pending_pid" 2>/dev/null || true
                    fi
                    { sleep "${HYPR_OUTPUT_PROFILE_SETTLE:-1.2}"; apply_profile; } &
                    pending_pid=$!
                    ;;
            esac
        done
    fi
fi