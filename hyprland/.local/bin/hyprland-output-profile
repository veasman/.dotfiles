#!/usr/bin/env sh
# hyprland-output-profile — dynamic docked/undocked monitor layout.
#
# Dispatches to hostname-specific profiles:
#   universe  — 3-monitor laptop dock (portrait sides + 1440p center + eDP-1)
#   computer  — simple desktop with optional 1440p@120 external
#
# Each sub-profile detects docked (1440p present) vs undocked and
# applies the right layout.
#
# Usage:
#   hyprland-output-profile           # apply layout (daemon mode)
#   hyprland-output-profile --swap    # swap cached left↔right sides
#   hyprland-output-profile --redetect  # clear cache and re-detect

set -eu

HOSTNAME=$(uname -n)

# --- state file (persists connector→side mapping across renames) -----
STATE_DIR="$HOME/.local/state/hypr"
STATE="$STATE_DIR/output-layout"
mkdir -p "$STATE_DIR" 2>/dev/null || true

read_state()  { [ -f "$STATE" ] && . "$STATE" || true; }
write_state() {
    printf 'left=%s\nleft_t=%s\ncenter=%s\nright=%s\nright_t=%s\n' \
        "$left" "${left_t:-3}" "$center" "$right" "${right_t:-1}" > "$STATE"
}

# --- logging ---------------------------------------------------------
SETTLE="${HYPR_OUTPUT_PROFILE_SETTLE:-1.2}"
LOGFILE="$HOME/.cache/hypr/output-profile.log"
mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null || true
log() {
    printf '%s %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo '?')" "$*" \
        >>"$LOGFILE" 2>/dev/null || true
}

# --- window migration ---------------------------------------------------
# Move all windows on a given monitor to a target workspace number.
migrate_from_monitor() {
    src="$1"
    target_ws="$2"
    hyprctl clients -j 2>/dev/null | jq -r --arg m "$src" '
        .[] | select(.monitor == $m) | .address
    ' | while IFS= read -r addr; do
        [ -n "$addr" ] && hyprctl dispatch movetoworkspacesilent "$target_ws,address:$addr" >/dev/null 2>&1 || true
    done
    log "migrated $src => workspace $target_ws"
}

# Move all non-laptop windows to a target workspace.
migrate_external_to() {
    target_ws="$1"
    all=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | .name')
    for mon in $all; do
        [ "$mon" = "$laptop" ] && continue
        migrate_from_monitor "$mon" "$target_ws"
    done
}

# --- core -------------------------------------------------------------
apply_profile_universe() {
    all=$(hyprctl monitors -j 2>/dev/null | jq -c '.[]' || true)
    names_connected=$(printf '%s\n' "$all" | jq -r '.name' | tr '\n' ' ')
    log "universe: connected = $names_connected"

    laptop="eDP-1"
    center=$(printf '%s\n' "$all" | jq -r 'select(.availableModes | any(startswith("2560x1440"))) | .name' | head -1)

    if [ -n "$center" ]; then
        read_state
        names_list=$(printf '%s\n' "$all" | jq -r '.name')
        stale=false
        for v in "${left:-}" "${center:-}" "${right:-}"; do
            [ -n "$v" ] || { stale=true; break; }
            printf '%s\n' "$names_list" | grep -Fxq "$v" || { stale=true; break; }
        done
        center_name=$(printf '%s\n' "$all" | jq -r 'select(.availableModes | any(startswith("2560x1440"))) | .name' | head -1)
        if $stale; then
            log "universe: state stale — re-detecting"
            sides=$(printf '%s\n' "$all" \
                | jq -r 'select(.name | startswith("eDP") | not) | select(((.availableModes | any(startswith("2560x1440"))) | not) and (.availableModes | any(startswith("1920x1080")))) | "\(.x) \(.name)"')
            side_count=$(printf '%s\n' "$sides" | grep -c . || true)
            if [ "$side_count" -ge 2 ]; then
                left=$(printf '%s\n' "$sides" | sort -n -k1 | awk '{print $2}' | sed -n '1p')
                right=$(printf '%s\n' "$sides" | sort -n -k1 | awk '{print $2}' | sed -n '2p')
                log "universe: detection: center=$center left=$left right=$right"
            fi
            transform_for() {
                case "$1" in
                    DVI-I-2) echo 1 ;;
                    DP-2)    echo 3 ;;
                    *)       echo "${2:-1}" ;;
                esac
            }
            if [ -n "${left:-}" ];  then left_t=$(transform_for "$left" 3);  fi
            if [ -n "${right:-}" ]; then right_t=$(transform_for "$right" 1); fi
            [ -z "${left:-}" ] && left="$center"
            [ -z "${right:-}" ] && right="$center"
            center="$center_name"
            write_state
        fi

        log "universe: docked  left=$left  center=$center  right=$right"

        migrate_from_monitor "$laptop" 1

        [ -n "$left"  ] && hyprctl keyword monitor "$left,1920x1080,0x0,1,transform,${left_t:-3}"    >/dev/null 2>&1 || true
                               hyprctl keyword monitor "$center,2560x1440@120,1080x0,1"    >/dev/null 2>&1 || true
        [ -n "$right" ] && hyprctl keyword monitor "$right,1920x1080,3640x0,1,transform,${right_t:-1}" >/dev/null 2>&1 || true
                               hyprctl keyword monitor "$laptop,preferred,auto,1"          >/dev/null 2>&1 || true

        [ -n "$left"  ] && hyprctl keyword workspace "r[11-19],monitor:$left,default:true"   >/dev/null 2>&1 || true
                               hyprctl keyword workspace "r[21-29],monitor:$center,default:true" >/dev/null 2>&1 || true
        [ -n "$right" ] && hyprctl keyword workspace "r[31-39],monitor:$right,default:true"  >/dev/null 2>&1 || true

        hyprctl dispatch focusmonitor "$center"                           >/dev/null 2>&1 || true
    else
        log "universe: undocked -> enabling $laptop"
        migrate_external_to 1
        hyprctl keyword monitor "$laptop,preferred,auto,1"                >/dev/null 2>&1 || true
        sleep 0.3
        migrate_from_monitor "$laptop" 1
        hyprctl dispatch focusmonitor "$laptop"                           >/dev/null 2>&1 || true
    fi
}

apply_profile_computer() {
    all=$(hyprctl monitors -j 2>/dev/null | jq -c '.[]' || true)
    names_connected=$(printf '%s\n' "$all" | jq -r '.name' | sort | tr '\n' ' ')
    log "computer: connected = $names_connected"

    # Use preferred mode for every monitor — no aggressive refresh hunt.
    # DP-to-HDMI adapters often advertise 1440p in EDID but can't drive
    # it at a usable mode; "preferred" lets the driver negotiate safely.
    echo "$all" | jq -r '.name' | while read -r name; do
        [ -z "$name" ] && continue
        hyprctl keyword monitor "$name,preferred,auto,1" >/dev/null 2>&1 || true
    done

    hyprctl dispatch focusmonitor "$(echo "$all" | jq -r '.name' | head -1)" >/dev/null 2>&1 || true
}

# --- hostname dispatch -------------------------------------------------
apply_profile() {
    case "$HOSTNAME" in
        universe) apply_profile_universe ;;
        computer) apply_profile_computer ;;
        *)
            log "skip: unknown host $HOSTNAME"
            ;;
    esac
}

# --- side-swap helper (universe only) ----------------------------------
swap_sides() {
    [ "$HOSTNAME" = universe ] || { echo "swap is only valid on universe" >&2; exit 1; }
    read_state
    if [ -z "${left:-}" ] || [ -z "${right:-}" ]; then
        echo "no cached layout to swap — run the daemon first" >&2
        exit 1
    fi
    tmp="$left"; left="$right"; right="$tmp"
    tmp_t="${left_t:-3}"; left_t="${right_t:-1}"; right_t="$tmp_t"
    write_state
    echo "swapped: left=$left right=$right"
    apply_profile
}

# --- CLI (runs BEFORE the daemon lock so --swap isn't blocked) --------
case "${1:-}" in
    --swap|--swap-sides)
        swap_sides
        exit 0
        ;;
    --redetect)
        rm -f "$STATE"
        apply_profile
        exit 0
        ;;
    --once)
        pid=$(cat "$RUNTIME/hyprland-output-profile.pid" 2>/dev/null || true)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null && sleep 0.3 || true
        apply_profile
        exit 0
        ;;
esac

# --- daemon lock ------------------------------------------------------
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
PIDFILE="$RUNTIME/hyprland-output-profile.pid"
LOCK="$RUNTIME/hyprland-output-profile.lock"
exec 9>"$LOCK"
flock -n 9 || exit 0
printf '%s\n' "$$" > "$PIDFILE"

# --- debounced apply (collapses connector-flap storms) -----------------
pending_pid=""
schedule_apply() {
    if [ -n "$pending_pid" ]; then
        kill "$pending_pid" 2>/dev/null || true
        wait "$pending_pid" 2>/dev/null || true
    fi
    { sleep "$SETTLE"; apply_profile; } &
    pending_pid=$!
}

# --- daemon entry point -----------------------------------------------
log "start (settle=${SETTLE}s)"
apply_profile

SOCK="$RUNTIME/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"
[ -S "$SOCK" ] || { log "no socket2 at $SOCK; exiting"; exit 0; }

if command -v socat >/dev/null 2>&1; then
    socat -U - "UNIX-CONNECT:$SOCK" 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            monitoradded*|monitorremoved*|monitoraddedv2*|monitorremovedv2*)
                log "event: ${line%%>>*}"
                schedule_apply
                ;;
        esac
    done
fi